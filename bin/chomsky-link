#!/bin/bash
# chomsky-link: (re)generate thin ~/.local/bin wrappers onto this plugin's
# bundled CLIs, under their pre-Chomsky names. Not required for the plugin or
# panel to work -- BarWidget.qml and the menu rows call the bin/ scripts
# directly -- this is purely for keybinds and habits that already reference
# omarchy-anim / omarchy-shader / omarchy-monitor-rotate / omarchy-wallpaper
# by name.
#
# Safe to re-run any time (e.g. after `omarchy plugin update`): each wrapper
# is regenerated in place.

set -euo pipefail

readonly PLUGIN_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly TARGET_DIR="$HOME/.local/bin"

mkdir -p "$TARGET_DIR"

write_wrapper() {
  local name="$1" target="$2"
  cat > "$TARGET_DIR/$name" <<EOF
#!/bin/bash
# Generated by chomsky-link -- thin wrapper onto the alhasapi.chomsky plugin.
exec "$PLUGIN_BIN/$target" "\$@"
EOF
  chmod +x "$TARGET_DIR/$name"
  echo "linked $TARGET_DIR/$name -> $PLUGIN_BIN/$target"
}

write_wrapper omarchy-anim chomsky-anim
write_wrapper omarchy-shader chomsky-shader
write_wrapper omarchy-monitor-rotate chomsky-monitor-rotate
write_wrapper omarchy-wallpaper chomsky-wallpaper
