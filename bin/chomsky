#!/bin/bash
# chomsky: the whole integration surface between the Chomsky bar plugin's
# QML and the standalone CLIs it drives (chomsky-anim, chomsky-shader,
# chomsky-window, chomsky-monitor-rotate, chomsky-wallpaper). The
# QML calls only this script; if any of those CLIs changes, only this file
# follows.

set -uo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly BIN_DIR

err() { echo "chomsky: $*" >&2; }

# ---- status: one line of JSON describing everything the panel shows -------
cmd_status() {
  local animation shader shader_on theme background resize_on_border dim_inactive dim_strength keybindings bar_chip

  animation="$("$BIN_DIR/chomsky-anim" current 2> /dev/null || echo '(none)')"
  shader="$("$BIN_DIR/chomsky-shader" current 2> /dev/null || echo off)"
  [[ "$shader" == "off" ]] && shader_on=false || shader_on=true
  theme="$(omarchy theme current 2> /dev/null || echo '')"
  background="$(readlink -f "$HOME/.local/state/omarchy/current/background" 2> /dev/null || echo '')"
  keybindings="$("$BIN_DIR/chomsky-keys" current 2> /dev/null || echo omarchy)"
  # No fallback value: "on" here would claim a chip is on the bar whenever the
  # script could not be run at all, which is exactly the kind of quiet lie the
  # panel is supposed to stop telling. Empty means unknown, treated as off.
  bar_chip="$("$BIN_DIR/chomsky-bar" status 2> /dev/null || true)"

  local window_state
  window_state="$("$BIN_DIR/chomsky-window" current 2> /dev/null || echo off)"
  [[ "$window_state" == "on" ]] && resize_on_border=true || resize_on_border=false
  dim_inactive="$resize_on_border"
  dim_strength="$(hyprctl getoption decoration:dim_strength 2> /dev/null | awk -F': ' '/^float:/ {print $2}')"
  [[ -n "$dim_strength" ]] || dim_strength="0.15"

  jq -n \
    --arg animation "$animation" \
    --arg shader "$shader" \
    --argjson shaderOn "$shader_on" \
    --arg theme "$theme" \
    --arg background "$background" \
    --argjson resizeOnBorder "$resize_on_border" \
    --argjson dimInactive "$dim_inactive" \
    --argjson dimStrength "$dim_strength" \
    --arg keybindings "$keybindings" \
    --arg barChip "$bar_chip" \
    '{animation:$animation, shader:$shader, shaderOn:$shaderOn, theme:$theme, background:$background, resizeOnBorder:$resizeOnBorder, dimInactive:$dimInactive, dimStrength:$dimStrength, keybindings:$keybindings, barChip:$barChip}'
}

# ---- lists, for the panel's dropdowns --------------------------------------
cmd_animations() {
  local current
  current="$("$BIN_DIR/chomsky-anim" current 2> /dev/null || echo '')"
  "$BIN_DIR/chomsky-anim" list 2> /dev/null | while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    jq -n --arg name "$name" --argjson current "$([[ "$name" == "$current" ]] && echo true || echo false)" \
      '{name:$name, current:$current}'
  done | jq -s '.'
}

cmd_shaders() {
  local current
  current="$("$BIN_DIR/chomsky-shader" current 2> /dev/null || echo off)"
  "$BIN_DIR/chomsky-shader" list 2> /dev/null | while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    jq -n --arg name "$name" --argjson current "$([[ "$name" == "$current" ]] && echo true || echo false)" \
      '{name:$name, current:$current}'
  done | jq -s '.'
}

# ---- actions ----------------------------------------------------------------
case "${1:-}" in
  status) cmd_status ;;
  animations) cmd_animations ;;
  shaders) cmd_shaders ;;
  anim)
    shift
    exec "$BIN_DIR/chomsky-anim" "$@"
    ;;
  shader)
    shift
    exec "$BIN_DIR/chomsky-shader" "$@"
    ;;
  window)
    shift
    exec "$BIN_DIR/chomsky-window" "$@"
    ;;
  rotate)
    shift
    exec "$BIN_DIR/chomsky-monitor-rotate" "$@"
    ;;
  keys)
    shift
    exec "$BIN_DIR/chomsky-keys" "$@"
    ;;
  bar)
    shift
    exec "$BIN_DIR/chomsky-bar" "$@"
    ;;
  bg-next) exec "$BIN_DIR/chomsky-wallpaper" next ;;
  bg-prev) exec "$BIN_DIR/chomsky-wallpaper" prev ;;
  wallpaper)
    shift
    exec "$BIN_DIR/chomsky-wallpaper" "$@"
    ;;
  menu-install)
    shift
    exec "$BIN_DIR/chomsky-menu-install" "$@"
    ;;
  reload) exec hyprctl reload ;;
  dpms)
    shift
    case "${1:-}" in
      off) hyprctl dispatch dpms off ;;
      on) hyprctl dispatch dpms on ;;
      *)
        err "usage: chomsky dpms <on|off>"
        exit 1
        ;;
    esac
    ;;
  *)
    echo "Usage: chomsky <status|animations|shaders|anim|shader|window|keys|bar|rotate|bg-next|bg-prev|wallpaper|menu-install|reload|dpms> ..." >&2
    exit 1
    ;;
esac
