#!/bin/bash
# chomsky-keys: switch Hyprland's keybindings between Omarchy's shipped
# defaults and the Dusky port, from the panel or the Omarchy menu.
#
# The switch is a file in Omarchy's own toggle-flag directory
# (~/.local/state/omarchy/toggles/hypr/), which default/hypr/toggles.lua
# sources last on every `hyprctl reload` -- after Omarchy's defaults and after
# the user's own ~/.config/hypr/bindings.lua. Loading last is what lets one
# mode win over the other without editing anyone's config, and what makes the
# switch a reload rather than a logout.
#
# The generated file is the single source of truth for `current`: it names the
# mode it applies. A machine that has never switched has no file and no
# keybindings of ours in play, so installing the plugin never changes anybody's
# keys until they ask for it.
#
#     chomsky-keys               # print the current mode
#     chomsky-keys dusky         # Dusky's bindings
#     chomsky-keys omarchy       # Omarchy's defaults back
#     chomsky-keys toggle
#     chomsky-keys keys          # every key this toggle owns
#     chomsky-keys reset         # drop the file; leave the config alone

set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly PLUGIN_DIR
readonly TOGGLE_DIR="$HOME/.local/state/omarchy/toggles/hypr"
readonly TOGGLE="$TOGGLE_DIR/chomsky-keys.lua"
readonly MODULE_DIR="$PLUGIN_DIR/keys"

err() { echo "chomsky-keys: $*" >&2; }

usage() {
  cat >&2 << EOF
Usage: chomsky-keys [dusky|omarchy|toggle|current|keys|reset]

  dusky     Use the Dusky keybindings
  omarchy   Use Omarchy's shipped keybindings
  toggle    Switch to the other one
  current   Print the mode in force
  keys      Print every key the switch touches
  reset     Remove the toggle file, leaving your config in charge
EOF
  exit 1
}

# The mode the toggle file applies. No file means no mode of ours is loaded.
current_mode() {
  [[ -f "$TOGGLE" ]] || {
    echo omarchy
    return
  }

  local mode
  mode="$(sed -n 's/.*apply("\([a-z]*\)".*/\1/p' "$TOGGLE" | head -n1)"
  [[ "$mode" == "dusky" ]] && echo dusky || echo omarchy
}

reload_hyprland() {
  command -v hyprctl &> /dev/null && hyprctl reload &> /dev/null || true
}

write_toggle() {
  local mode="$1"

  # The path is embedded in a Lua string, so refuse anything that would have to
  # be escaped rather than write a file that fails to load on next reload.
  # `*\\*` is a glob for a literal backslash; the single-quoted form reads as
  # a broken escape, which is what shellcheck flags.
  if [[ "$PLUGIN_DIR" == *'"'* || "$PLUGIN_DIR" == *\\* ]]; then
    err "plugin path contains a quote or backslash, which cannot be embedded in Lua: $PLUGIN_DIR"
    exit 1
  fi
  [[ -f "$MODULE_DIR/chomsky_keys.lua" ]] || {
    err "missing $MODULE_DIR/chomsky_keys.lua"
    exit 1
  }

  mkdir -p "$TOGGLE_DIR"
  cat > "$TOGGLE" << EOF
-- Generated by chomsky-keys -- edit the mode with \`chomsky-keys dusky|omarchy\`,
-- not by hand. The bindings themselves live in the plugin:
--   $MODULE_DIR/chomsky_keys.lua
package.path = "$MODULE_DIR/?.lua;" .. package.path
require("chomsky_keys").apply("$mode", "$PLUGIN_DIR")
EOF

  reload_hyprland
}

case "${1:-current}" in
  current | "") current_mode ;;
  keys) sed -n '/^local KEYS = {/,/^}/p' "$MODULE_DIR/chomsky_keys.lua" | sed -n 's/^  "\(.*\)",.*/\1/p' ;;
  dusky | omarchy)
    write_toggle "$1"
    echo "Keybindings: $1"
    ;;
  toggle)
    if [[ "$(current_mode)" == "dusky" ]]; then
      next=omarchy
    else
      next=dusky
    fi
    write_toggle "$next"
    echo "Keybindings: $next"
    ;;
  reset)
    rm -f "$TOGGLE"
    reload_hyprland
    echo "Removed $TOGGLE; your own config is in charge of those keys again."
    ;;
  *) usage ;;
esac
