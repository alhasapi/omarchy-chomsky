#!/bin/bash
# chomsky-shader: switch Hyprland screen shaders (Dusky-derived GLSL set).
#
# Shaders live in <plugin>/shaders/*.glsl, shipped with the plugin, with a
# fallback scan of /usr/share/hyprshade/shaders for any system-installed
# extras.
#
# The shader is applied by writing a toggle file that Hyprland sources on every
# reload -- not by `hyprctl keyword decoration:screen_shader` (which refuses to
# work on Lua-parser builds) and not by a one-off `hyprctl eval` either, since
# a runtime value is lost the next time anything reloads the config.

set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly PLUGIN_DIR
readonly SHADER_DIRS=("$PLUGIN_DIR/shaders" "/usr/share/hyprshade/shaders")
readonly STATE_DIR="$HOME/.local/state/chomsky"
readonly TOGGLE_DIR="$HOME/.local/state/omarchy/toggles/hypr"
# The shader lives in a toggle file rather than being eval'd at runtime, for the
# same reason the animation preset does: `default/hypr/toggles.lua` sources this
# directory on every `hyprctl reload`, so the shader comes back after one. A
# runtime `hl.config` (via `hyprctl eval`) does not -- which is what used to let
# the panel claim a shader was on while nothing was painted.
readonly TOGGLE_FILE="$TOGGLE_DIR/chomsky-shader.lua"

err() { echo "chomsky-shader: $*" >&2; }

reload_hyprland() {
  command -v hyprctl &> /dev/null && hyprctl reload &> /dev/null || true
}

list_shaders() {
  local dir f name
  for dir in "${SHADER_DIRS[@]}"; do
    [[ -d "$dir" ]] || continue
    for f in "$dir"/*.glsl "$dir"/*.frag; do
      [[ -f "$f" ]] || continue
      name="$(basename "$f")"
      name="${name%.glsl}"
      name="${name%.frag}"
      printf '%s\n' "$name"
    done
  done | sort -u
}

resolve_shader_path() {
  local name="$1"
  local dir ext
  for dir in "${SHADER_DIRS[@]}"; do
    for ext in glsl frag; do
      if [[ -f "$dir/$name.$ext" ]]; then
        printf '%s\n' "$dir/$name.$ext"
        return 0
      fi
    done
  done
  return 1
}

# What Hyprland actually has applied. Authoritative on purpose: reading a
# record of what we asked for would report a shader as on whenever the two
# disagree, and they disagree every time something reloads the config.
current_shader() {
  local out
  out="$(hyprctl getoption decoration:screen_shader 2> /dev/null | sed -n 's/^str:[[:space:]]*//p' | head -n1)"
  out="${out%% set:*}" # hyprctl appends " set: false/true" to the value
  if [[ -z "$out" || "$out" == "[[EMPTY]]"* ]]; then
    echo "off"
    return
  fi
  out="$(basename "$out")"
  printf '%s\n' "${out%.glsl}"
}

# What the plugin last asked for, read back from the toggle file itself.
desired_shader() {
  local path
  [[ -f "$TOGGLE_FILE" ]] || {
    echo "off"
    return
  }
  path="$(sed -n 's/.*screen_shader[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$TOGGLE_FILE" | head -n1)"
  [[ -z "$path" ]] && {
    echo "off"
    return
  }
  path="$(basename "$path")"
  printf '%s\n' "${path%.glsl}"
}

write_toggle() {
  local path="${1:-}"
  mkdir -p "$TOGGLE_DIR" "$STATE_DIR"

  if [[ -z "$path" ]]; then
    rm -f "$TOGGLE_FILE"
    return
  fi

  # mktemp in the SAME directory as the destination so the final mv is an
  # atomic same-filesystem inode swap (Hyprland may reload mid-write).
  local tmp
  tmp="$(mktemp "$TOGGLE_DIR/.chomsky-shader.XXXXXX.tmp")"
  trap 'rm -f "$tmp"' EXIT
  {
    printf '%s\n' "-- Screen shader, applied by chomsky-shader."
    printf '%s\n' "--"
    printf '%s\n' "-- Written here rather than set at runtime so that it survives a"
    printf '%s\n' "-- reload: default/hypr/toggles.lua sources this directory last."
    printf 'hl.config({ decoration = { screen_shader = "%s" } })\n' "$path"
  } > "$tmp"
  chmod 644 "$tmp"
  mv -f -- "$tmp" "$TOGGLE_FILE"
  trap - EXIT
}

apply_off() {
  write_toggle ""
  reload_hyprland
  echo "Shader off"
}

apply_shader() {
  local name="$1"
  local path
  if ! path="$(resolve_shader_path "$name")"; then
    err "unknown shader: $name (try 'chomsky-shader list')"
    exit 1
  fi
  write_toggle "$path"
  reload_hyprland
  echo "Shader set to: $name"
}

# Bring Hyprland back in line with the toggle file. Called at shell startup by
# the plugin's service, and useful after anything that reloaded the config
# behind our back. A reload is the whole reconciliation: the config is what
# decides the shader, so re-reading it converges on the truth either way --
# shader back on when the toggle file says so, cleared when it does not.
restore() {
  local want live
  want="$(desired_shader)"
  live="$(current_shader)"
  [[ "$want" == "$live" ]] && return 0
  reload_hyprland
}

toggle() {
  local cur
  cur="$(current_shader)"
  if [[ "$cur" == "off" ]]; then
    mapfile -t shaders < <(list_shaders)
    if ((${#shaders[@]} == 0)); then
      err "no shaders found"
      exit 1
    fi
    apply_shader "${shaders[0]}"
  else
    apply_off
  fi
}

cycle() {
  local direction="${1:-next}"
  mapfile -t shaders < <(list_shaders)
  local total="${#shaders[@]}"
  if ((total == 0)); then
    err "no shaders found"
    exit 1
  fi

  local cur idx=-1
  cur="$(current_shader)"
  for i in "${!shaders[@]}"; do
    if [[ "${shaders[$i]}" == "$cur" ]]; then
      idx=$i
      break
    fi
  done

  local new_idx
  if [[ "$direction" == "prev" ]]; then
    if ((idx <= 0)); then new_idx=$((total - 1)); else new_idx=$((idx - 1)); fi
  else
    if ((idx == -1)); then new_idx=0; else new_idx=$(((idx + 1) % total)); fi
  fi

  apply_shader "${shaders[$new_idx]}"
}

menu() {
  mapfile -t shaders < <(list_shaders)
  local choice
  choice="$(omarchy-menu-select "Shader" "Off" "${shaders[@]}" -- --width 30)" || exit 0
  if [[ "$choice" == "Off" ]]; then
    apply_off
  elif [[ -n "$choice" ]]; then
    apply_shader "$choice"
  fi
}

usage() {
  cat >&2 << EOF
Usage: chomsky-shader <command> [args]

Commands:
  list            List available shaders
  set <name>      Apply a shader by name
  off             Clear the active shader
  toggle          Turn the last/first shader on, or off if one is active
  current         Print the shader Hyprland actually has on ("off" if none)
  next            Cycle to the next shader
  prev            Cycle to the previous shader
  restore         Make Hyprland match the toggle file (used at shell startup)
  menu            Pick a shader interactively
EOF
  exit 1
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    list) list_shaders ;;
    set)
      [[ -n "${2:-}" ]] || {
        err "set requires a shader name"
        exit 1
      }
      apply_shader "$2"
      ;;
    off) apply_off ;;
    toggle) toggle ;;
    current) current_shader ;;
    next) cycle next ;;
    prev) cycle prev ;;
    restore) restore ;;
    menu) menu ;;
    *) usage ;;
  esac
}

main "$@"
