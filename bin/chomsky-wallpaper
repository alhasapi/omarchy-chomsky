#!/bin/bash
# chomsky-wallpaper: cycle, pick, or set wallpapers across the active Omarchy
# theme and ~/Pictures (including one level of subdirectories, excluding
# screenshots).
#
# Everything is applied through Omarchy's own `omarchy-theme-bg-set`, which
# symlinks ~/.local/state/omarchy/current/background and tells the running
# shell to repaint. Picking reuses Omarchy's own thumbnail-grid image picker,
# so a wallpaper is chosen by preview and returned as an exact path rather than
# as a display string.

set -euo pipefail

readonly STATE_CURRENT="$HOME/.local/state/omarchy/current"
readonly USER_CONFIG="$HOME/.config/omarchy"
readonly PICTURES_DIR="$HOME/Pictures"

# The picker's finished/choice files, kept at file scope for the EXIT trap.
PICKER_SELECTION_FILE=""
PICKER_DONE_FILE=""

# The same extensions Omarchy's own `omarchy-theme-bg-next` walks, so what this
# script calls a wallpaper matches what the rest of Omarchy does.
readonly IMAGE_MATCH=( \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) )

err() { echo "chomsky-wallpaper: $*" >&2; }

current_wallpaper() {
  local bg_link="$STATE_CURRENT/background"
  if [[ -L "$bg_link" ]]; then
    readlink -f "$bg_link" 2>/dev/null || readlink "$bg_link" 2>/dev/null || echo ""
  else
    echo ""
  fi
}

# Directories that may hold wallpapers for the active theme, plus ~/Pictures.
# Roots are printed whether or not they exist; callers filter.
search_roots() {
  local theme_name=""
  [[ -f "$STATE_CURRENT/theme.name" ]] && theme_name="$(< "$STATE_CURRENT/theme.name")"

  [[ -n "$theme_name" ]] && printf '%s\n' "$USER_CONFIG/backgrounds/$theme_name"
  printf '%s\n' "$STATE_CURRENT/theme/backgrounds"
  printf '%s\n' "$PICTURES_DIR"
}

# Every directory the wallpaper walk actually descends into: the roots above,
# plus their immediate subdirectories when those hold at least one image. One
# level deep only -- and since the subdirectories are listed explicitly, the
# cycle and the picker see exactly the same set of files. Deduplicated, and
# only directories that exist and hold an image, so the picker never opens on
# an empty section.
wallpaper_dirs() {
  local root sub
  while IFS= read -r root; do
    [[ -d "$root" ]] || continue
    printf '%s\n' "$root"

    while IFS= read -r sub; do
      [[ -n "$sub" ]] || continue
      if find -L "$sub" -maxdepth 1 -type f "${IMAGE_MATCH[@]}" \
           ! -iname '*screenshot*' -print -quit 2>/dev/null | grep -q .; then
        printf '%s\n' "$sub"
      fi
    done < <(find -L "$root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
  done < <(search_roots) | sort -u
}

list_wallpapers() {
  local -a dirs=()
  mapfile -t dirs < <(wallpaper_dirs)
  (( ${#dirs[@]} > 0 )) || return 0

  find -L "${dirs[@]}" -maxdepth 1 -type f "${IMAGE_MATCH[@]}" \
    ! -iname '*screenshot*' -print0 2>/dev/null | sort -z | tr '\0' '\n'
}

apply_wallpaper() {
  local target="$1"
  if [[ ! -f "$target" ]]; then
    err "file does not exist: $target"
    exit 1
  fi

  # omarchy-theme-bg-set is what Omarchy uses for its own background switcher,
  # so this behaves the same as Style > Background. No notification: the
  # wallpaper is visible the moment it changes, and cycling through a handful
  # of images should not leave a stack of toasts behind it.
  omarchy-theme-bg-set "$target"

  echo "Wallpaper set to: $target"
}

cycle_wallpaper() {
  local direction="${1:-next}"
  mapfile -t wallpapers < <(list_wallpapers)
  local total="${#wallpapers[@]}"

  if (( total == 0 )); then
    err "no wallpapers found in the active theme or $PICTURES_DIR"
    exit 1
  fi

  local cur idx=-1
  cur="$(current_wallpaper)"

  if [[ -n "$cur" ]]; then
    for i in "${!wallpapers[@]}"; do
      if [[ "${wallpapers[$i]}" == "$cur" ]]; then
        idx=$i
        break
      fi
    done
  fi

  local new_idx
  if [[ "$direction" == "prev" ]]; then
    if (( idx <= 0 )); then
      new_idx=$(( total - 1 ))
    else
      new_idx=$(( idx - 1 ))
    fi
  else
    if (( idx == -1 )); then
      new_idx=0
    else
      new_idx=$(( (idx + 1) % total ))
    fi
  fi

  apply_wallpaper "${wallpapers[$new_idx]}"
}

# --- The picker ------------------------------------------------------------
#
# Two ways in, because Omarchy's front-end alone cannot always do it.
#
# `omarchy-menu-images` hands the picker its entire image list base64-encoded in
# one command-line argument, and Linux caps a single argument at 128 KiB. With
# enough wallpapers that limit is reached -- this machine's ~/Pictures alone
# holds 1121 images, which is a ~128 KiB argument -- and the picker fails with
# "Argument list too long" instead of opening. So: use the front-end while the
# list fits (it resolves thumbnails up front and caches the list, which makes
# reopening instant), and otherwise drive the image-picker overlay directly with
# the *directories*, letting it enumerate them itself (its own list.sh, which
# has no size limit at all).

# Would handing the picker the whole row list overrun that per-argument limit?
# A rough estimate is all this needs to be: it only chooses between two ways
# that both work, so being wrong costs a few seconds rather than an answer.
picker_rows_too_long() {
  local bytes=0 path
  while IFS= read -r path; do
    bytes=$(( bytes + 2 * ${#path} + 80 ))
  done < <(list_wallpapers)
  (( bytes / 3 * 4 > 120 * 1024 ))
}

# The overlay's own contract, as the shell host exposes it: dirs (newline
# separated), then rows (empty -- we want it to enumerate), the image to
# highlight, where to write the choice, which file to create when finished, and
# two display flags. It blocks until that file appears, exactly like
# omarchy-menu-images, and creates it empty when the picker is dismissed.
picker_from_dirs() {
  local selected="$1"
  shift

  if ! command -v omarchy-shell >/dev/null 2>&1; then
    err "omarchy-shell is not on PATH (it ships with Omarchy 4)"
    exit 1
  fi

  # File-scope names on purpose: the EXIT trap below runs after this function
  # has returned, and `local` names are unbound by then (which under `set -u`
  # makes the trap itself fail, leaking the files and the exit status).
  local answer
  PICKER_SELECTION_FILE="$(mktemp)"
  PICKER_DONE_FILE="$(mktemp)"
  rm -f "$PICKER_DONE_FILE"
  trap 'rm -f "$PICKER_SELECTION_FILE" "$PICKER_DONE_FILE"' EXIT

  answer="$(omarchy-shell image-selector open \
    "$(printf '%s\n' "$@")" "" "$selected" "$PICKER_SELECTION_FILE" "$PICKER_DONE_FILE" "false" "true")" || true
  if [[ "$answer" != "ok" ]]; then
    err "the image picker did not open${answer:+ ($answer)}"
    exit 1
  fi

  while [[ ! -e "$PICKER_DONE_FILE" ]]; do
    sleep 0.05
  done

  [[ -s "$PICKER_SELECTION_FILE" ]] || return 0
  local picked
  picked="$(<"$PICKER_SELECTION_FILE")"
  rm -f "$PICKER_SELECTION_FILE" "$PICKER_DONE_FILE"
  apply_wallpaper "$picked"
}

menu_select() {
  local -a dirs=()
  mapfile -t dirs < <(wallpaper_dirs)

  if (( ${#dirs[@]} == 0 )); then
    err "no wallpaper directory found (looked in the active theme and $PICTURES_DIR)"
    exit 1
  fi

  local selected choice
  selected="$(current_wallpaper)"

  if command -v omarchy-menu-images >/dev/null 2>&1 && ! picker_rows_too_long; then
    # A non-zero exit means the front-end could not even open the picker; the
    # empty string with a zero exit is the user closing it without choosing.
    if choice="$(omarchy-menu-images --selected "$selected" --filterable "${dirs[@]}")"; then
      [[ -n "$choice" ]] && apply_wallpaper "$choice"
      return 0
    fi
  fi

  picker_from_dirs "$selected" "${dirs[@]}"
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    list) list_wallpapers ;;
    current) current_wallpaper ;;
    next) cycle_wallpaper next ;;
    prev) cycle_wallpaper prev ;;
    set)
      [[ -n "${2:-}" ]] || { err "set requires an image path"; exit 1; }
      apply_wallpaper "$2"
      ;;
    menu) menu_select ;;
    *) usage ;;
  esac
}

main "$@"
