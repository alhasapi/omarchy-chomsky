#!/bin/bash
# chomsky-theme-from-wallpaper: generate and apply an Omarchy theme from a
# wallpaper image, via matugen + Omarchy's own theme templating engine.
#
# Pipeline (all three steps are either matugen's own templating or Omarchy's
# own converter -- no hand-rolled Material-You-to-ANSI mapping to maintain):
#   wallpaper.jpg -> matugen (alacritty.toml template) -> <theme>/alacritty.toml
#                 -> omarchy-theme-colors-from-alacritty  -> <theme>/colors.toml
#                 -> omarchy theme set <name>             -> all 17 configs rendered

set -euo pipefail

readonly PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly TEMPLATE="$PLUGIN_DIR/templates/alacritty.toml"
readonly THEMES_DIR="$HOME/.config/omarchy/themes"

err() { echo "chomsky-theme-from-wallpaper: $*" >&2; }

usage() {
  cat >&2 <<EOF
Usage: chomsky-theme-from-wallpaper <image> [--name NAME] [--light]

Generates an Omarchy theme from the colors in <image> and applies it.
  --name NAME   Theme name (default: the image's basename, sanitized)
  --light       Generate a light-mode palette instead of dark
EOF
  exit 1
}

IMAGE=""
NAME=""
MODE="dark"

while (( $# > 0 )); do
  case "$1" in
    --name)
      [[ -n "${2:-}" ]] || { err "--name requires a value"; exit 1; }
      NAME="$2"
      shift 2
      ;;
    --light)
      MODE="light"
      shift
      ;;
    -h|--help)
      usage
      ;;
    *)
      if [[ -n "$IMAGE" ]]; then
        err "unexpected argument: $1"
        exit 1
      fi
      IMAGE="$1"
      shift
      ;;
  esac
done

[[ -n "$IMAGE" ]] || usage

IMAGE="$(realpath -e -- "$IMAGE" 2>/dev/null)" || { err "no such file: $IMAGE"; exit 1; }

if ! command -v matugen &>/dev/null; then
  err "matugen is not installed (omarchy pkg add matugen)"
  exit 1
fi

if [[ ! -f "$TEMPLATE" ]]; then
  err "template missing: $TEMPLATE"
  exit 1
fi

if [[ -z "$NAME" ]]; then
  NAME="$(basename -- "$IMAGE")"
  NAME="${NAME%.*}"
  NAME="$(echo "$NAME" | tr -c 'A-Za-z0-9_-' '-' | sed -e 's/-\{2,\}/-/g' -e 's/^-//' -e 's/-$//')"
  [[ -n "$NAME" ]] || NAME="wallpaper-theme"
fi

THEME_DIR="$THEMES_DIR/$NAME"
mkdir -p "$THEME_DIR/backgrounds"

# omarchy-theme-colors-from-alacritty skips generation if colors.toml already
# exists, so regenerating a theme means clearing the stale one first.
rm -f "$THEME_DIR/colors.toml"

MATUGEN_CFG="$(mktemp -d)/config.toml"
trap 'rm -rf "$(dirname "$MATUGEN_CFG")"' EXIT

cat > "$MATUGEN_CFG" <<EOF
[config]

[templates.alacritty]
input_path  = '$TEMPLATE'
output_path = '$THEME_DIR/alacritty.toml'
EOF

if ! matugen image "$IMAGE" -c "$MATUGEN_CFG" -m "$MODE" -q --source-color-index 0; then
  err "matugen failed to process $IMAGE"
  exit 1
fi

if [[ ! -f "$THEME_DIR/alacritty.toml" ]]; then
  err "matugen did not produce alacritty.toml"
  exit 1
fi

omarchy-theme-colors-from-alacritty "$THEME_DIR"

if [[ ! -f "$THEME_DIR/colors.toml" ]]; then
  err "failed to derive colors.toml from the generated palette"
  exit 1
fi

# Validate before applying: fail loudly rather than half-applying a broken
# theme. Captured into a variable first, then matched with a here-string --
# `cmd | grep -q` risks a SIGPIPE on the writer once grep exits early on its
# first match, which `pipefail` then reports as a spurious failure.
PALETTE="$(omarchy-theme-color --file "$THEME_DIR/colors.toml" --all)"
if ! grep -q '^background' <<< "$PALETTE"; then
  err "generated colors.toml looks incomplete, not applying"
  exit 1
fi

# Hard link, not symlink: `omarchy-theme-bg-set` realpath(1)s whatever it's
# given before recording it as the "current background", but
# `omarchy-theme-bg-next` compares against the *symlink's own path* as listed
# by `find`. A symlink here would realpath through to the Pictures file and
# never match, breaking cycling. A hard link has no target to resolve
# through; realpath on it returns this path itself, so it matches. Requires
# the wallpaper and ~/.config to share a filesystem.
if ! ln -f "$IMAGE" "$THEME_DIR/backgrounds/$(basename -- "$IMAGE")" 2>/dev/null; then
  cp -- "$IMAGE" "$THEME_DIR/backgrounds/$(basename -- "$IMAGE")"
fi

omarchy theme set "$NAME"
echo "Theme '$NAME' generated from $(basename -- "$IMAGE") and applied."
